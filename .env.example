# Backline environment — copy to .env and fill in what you have.
# Every value here has a working default for a local keyless boot:
# `docker compose up` works with no .env at all; tests never need an API key.

# ── Models ────────────────────────────────────────────────────────────────────
# Anthropic API key. Leave empty to run keyless: unit/integration tests use the
# MockProvider; only live agent runs and evals need this.
ANTHROPIC_API_KEY=

# Any OpenAI-format endpoint (vLLM local model, OpenAI, etc.), e.g.
# http://192.168.1.50:8000/v1 — used by the OpenAICompatProvider (Phase 2/7).
OPENAI_COMPAT_BASE_URL=
# Bearer token for that endpoint. Local vLLM ignores auth — leave empty.
OPENAI_COMPAT_API_KEY=

# Model ids, providers, context windows, and USD prices per 1M tokens live in
# config/models.yaml (editable without code changes; the CostMeter reads it).

# Model policy (§2): agent loops run on the planner tier; summarization/compression
# on the utility tier; the router front door classifies on the cheap tier. Any id
# from config/models.yaml works (e.g. local-qwen via OPENAI_COMPAT_BASE_URL).
PLANNER_MODEL=claude-sonnet-5
UTILITY_MODEL=claude-haiku-4-5
ROUTER_MODEL=claude-haiku-4-5
# T3 LLM-as-judge model for eval runs (Sonnet-class; §5.1) — the judge model and
# rubric hash are recorded with every judged result.
JUDGE_MODEL=claude-sonnet-5
# Below this route confidence the router asks a clarifying question instead of
# guessing an agent.
ROUTER_CONFIDENCE_THRESHOLD=0.6

# ── Synthetic world ───────────────────────────────────────────────────────────
# Master seed for the deterministic universe. Same seed => byte-identical world
# and identical answer key. Do not change casually — eval baselines and the
# committed golden fingerprint (tests/golden/) key off it.
WORLD_SEED=20260805

# Where generated data lives: contract PDFs, statement drops (inbox), traces.
# Host processes default to ./data; inside compose this is the /data volume.
DATA_DIR=data

# ── Retrieval ─────────────────────────────────────────────────────────────────
# Cross-encoder rerank stage: on|off (off exists so the eval harness can measure
# the rerank's lift; see BUILD_PLAN §4.4).
RERANK=on

# Embedding model for `make embed` and query-time search. The default runs on CPU
# via sentence-transformers (install the extra: `uv sync --extra embed`). Set to
# `hash` for the deterministic offline embedder (keyless CI / no-model machines);
# the chunk store records which model built it, and queries must use the same one.
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Cross-encoder model for the rerank stage (same `embed` extra). Set to `lexical`
# for the deterministic offline reranker.
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# sql_query tool: automatic/maximum LIMIT and the EXPLAIN cost ceiling (planner
# units) that rejects pathological queries before they run.
SQL_ROW_LIMIT=200
SQL_COST_CEILING=150000

# ── Budgets & run limits (hard caps) ──────────────────────────────────────────
# Per-agent-run spend ceiling: a run that hits it ends status=exhausted.
# The Reconciler's workflow cap is sized empirically in code ($2.50 floor,
# D-020); this knob can raise that cap above the floor, never shrink it.
RUN_BUDGET_USD=0.50
# Eval-harness ceiling per invocation; the runner refuses to exceed it.
EVAL_BUDGET_USD=5.00
# Agent-loop iteration cap; a run that hits it ends status=exhausted.
MAX_ITERATIONS=12
# Per-tool-call wall-clock timeout (seconds); a timed-out tool returns an error result.
TOOL_TIMEOUT_S=30
# Tool results above ~this many tokens are summarized by the utility model
# (traced as a `compression` span) before entering the context.
MAX_RESULT_TOKENS=2000

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_USER=backline
POSTGRES_PASSWORD=backline
POSTGRES_DB=backline
# Used by processes on the host (tests, scripts). Inside compose the api/init
# services override the host with `db`.
DATABASE_URL=postgresql://backline:backline@localhost:5432/backline

# ── Ports (host side) ─────────────────────────────────────────────────────────
DB_PORT=5432
API_PORT=8000
UI_PORT=3000
